@page "/Matches"
@using AnglingClubShared.Entities
@using AnglingClubShared.Enums
@using AnglingClubWebsite.Models
@using Microsoft.AspNetCore.Components.QuickGrid
@using Syncfusion.Blazor.Grids
@using AnglingClubShared.Extensions
@inherits RazorComponentBase

<AuthorizationRequired>
    <div class="page-header">
        <h3 class="left-header">Matches</h3>

        <SeasonSelector OnSeasonChanged="SeasonChanged" />
    </div>

    <BusyIndicator IsReady="@DataLoaded"></BusyIndicator>

    @if (DataLoaded)
    {
        <p>You can see the results by selecting the match.</p>

        <MobileTabScroller ScrollAmount="180">
            <SfTab ID="Tab"
                   EnablePersistence="false"
                   SelectedItem="SelectedTab"
                   OverflowMode="OverflowMode.Scrollable"
                   Width="100%">
                <TabEvents Selected="OnTabSelected"></TabEvents>
                <TabItems>
                    @foreach (TabData Item in MatchTabItems)
                    {
                        <TabItem>
                            <HeaderTemplate>
                                @if (BrowserSize == DeviceSize.Small)
                                {
                                    <div>@(Item.HeaderBrief)</div>
                                }
                                else
                                {
                                    <div>@(Item.HeaderFull)</div>
                                }

                            </HeaderTemplate>
                        </TabItem>
                    }
                </TabItems>
            </SfTab>
        </MobileTabScroller>

        <QuickGrid Items="MatchesQueryable" Class="bdac-table">

            <TemplateColumn Title="Date" IsDefaultSortColumn="true" Sortable="true" SortBy="@SortByDate">
                <ChildContent Context="row">
                    <BdacGridCell TItem="ClubEvent"
                                    Item="row"
                                    AdditionalClass="@CellClass(row)"
                                    OnSelect="MatchSelectedHandler">
                        <span class="nowrap">@row.Date.BdacDate()</span>
                    </BdacGridCell>
                </ChildContent>
            </TemplateColumn>

            <TemplateColumn Title="Venue">
                <ChildContent Context="row">
                    <BdacGridCell TItem="ClubEvent"
                                    Item="row"
                                    AdditionalClass="@CellClass(row)"
                                    OnSelect="MatchSelectedHandler">
                        @row.Description
                    </BdacGridCell>
                </ChildContent>
            </TemplateColumn>

            @if (IsCupVisible())
            {
                <TemplateColumn Title="Cup">
                    <ChildContent Context="row">
                        <BdacGridCell TItem="ClubEvent"
                                        Item="row"
                                        AdditionalClass="@CellClass(row)"
                                        OnSelect="MatchSelectedHandler">
                            @row.Cup
                        </BdacGridCell>
                    </ChildContent>
                </TemplateColumn>
            }

            <TemplateColumn Title="No" Align="Align.Right">
                <ChildContent Context="row">
                    <BdacGridCell TItem="ClubEvent"
                                    Item="row"
                                    AdditionalClass="@CellClass(row)"
                                    OnSelect="MatchSelectedHandler">
                        @(row.Number != null ? row.Number.Value.ToString("N0") : 0)
                    </BdacGridCell>
                </ChildContent>
            </TemplateColumn>

        </QuickGrid>

        @* Note the 2-way binding of the Visible property *@
        <MatchResultsPopup @bind-Visible="ShowingResults" SelectedMatch="@SelectedMatch"></MatchResultsPopup>

    }
</AuthorizationRequired>

