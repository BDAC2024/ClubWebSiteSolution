@page "/News"

@using AnglingClubShared.Extensions;
@inherits RazorComponentBase

<div class="page-header">
    <h3 class="@(CurrentUser.Admin ? "left-header" : "")">Latest News</h3>

    @if (CurrentUser.Admin)
    {
        <div class="edit-button-panel">
            @if (IsUnlocked)
            {
                <SfButton CssClass="e-primary edit-button" @onclick="AddNewsItem"><i class="fa-solid fa-add" /> Add news item</SfButton>
            }

            @if (!IsUnlocked)
            {
                <SfButton CssClass="e-primary edit-button" @onclick="(() => Unlock(true))"><i class="fa-solid fa-lock-open" /> Unlock</SfButton>
            }
            else
            {
                <SfButton CssClass="e-primary edit-button" @onclick="(() => Unlock(false))"><i class="fa-solid fa-lock" /> Lock</SfButton>
            }
        </div>
        <br />
        <br />
    }
</div>

<BusyIndicator IsReady="@DataLoaded"></BusyIndicator>

@if (IsAdding)
{
    <EditableCard Submitting="Submitting"
                  CancelAction="@(() => _ = Cancel())"
                  SaveAction="@(() => _ = Save())">
        <EditableNewsCardContent Item="@NewsItem"></EditableNewsCardContent>
    </EditableCard>
}

@foreach (var item in Items)
{
    @if (NewsItem != null && NewsItem.DbKey == item.DbKey)
    {
        <EditableCard Submitting="Submitting"
                      CancelAction="@(() => _ = Cancel())"
                      SaveAction="@(() => _ = Save())">
            <EditableNewsCardContent Item="@NewsItem"></EditableNewsCardContent>
        </EditableCard>
    }
    else
    {
        <NewsCard ItemId="@item.DbKey"
                  Title="@item.Title"
                  SubTitle="@item.Date.BdacDate()"
                  IsNew="IsNew(item.Date)"
                  Button1Text="@(IsUnlocked ? "Delete" : "")"
                  Button1Icon="@(IsUnlocked ? "fa-trash" : "")"
                  Button1Action="@((string itemId) => OnNewsItemDeleted(item))"
                  Button2Text="@(IsUnlocked ? "Edit" : "")"
                  Button2Icon="@(IsUnlocked ? "fa-pencil" : "")"
                  Button2Action="@((string itemId) => OnNewsItemEdited(itemId))">
            @((MarkupString)item.Body)
        </NewsCard>
    }
}

