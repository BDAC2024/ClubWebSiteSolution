@inherits LayoutComponentBase

<div class="embedded-blazor-content">

    @if (debuggingDeviceType)
    {
        <span class="floating-panel">
            Size: <b>@BrowserSize</b> Portrait: <b>@BrowserPortrait</b> Dims: <b>@BrowserWidth</b> x <b>@BrowserHeight</b>
        </span>
    }

    <div id="blazor-content"
         class="main-content">
        <div id="main-content">
            @Body
        </div>
    </div>

</div>
